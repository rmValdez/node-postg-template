generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String         @id @default(uuid())
  slug        String         @unique // "angular-v4", "next-v1", "vue-v3", "nuxt-v2", "default"
  name        String
  description String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  users       User[]
  quizQuestions QuizQuestion[]
  quizProgress QuizProgress[]
}

model User {
  id                  String                 @id @default(uuid())
  tenantId            String?
  email               String                 @unique
  password            String?                // Optional for social-only users
  name                String?
  username            String                 @unique
  role                UserRole               @default(USER)
  isActive            Boolean                @default(true)
  lastLoginAt         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  avatarId            String?
  isDeleted           Boolean                @default(false)
  isEmailVerified     Boolean                @default(true)
  onboardingCompleted Boolean                @default(false)
  
  tenant              Tenant?                @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  avatar              File?                  @relation("UserAvatar", fields: [avatarId], references: [id])
  sessions            Session[]
  socialAccounts      SessionSocialAccount[]
  quizProgress        QuizProgress[]

  @@index([tenantId])
}

model Session {
  id                String   @id @default(uuid())
  userId            String
  createdAt         DateTime @default(now())
  expiresAt         DateTime
  refreshToken      String   @unique
  provider          String?
  providerAvatarUrl String?

  user              User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model SessionSocialAccount {
  id             String    @id @default(uuid())
  userId         String
  platform       String
  providerUserId String
  accessToken    String
  refreshToken   String?
  expiresAt      DateTime?
  scopes         String?
  avatarUrl      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id])

  @@unique([userId, platform])
}

model File {
  id        String    @id @default(uuid())
  filename  String?
  fileUrl   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  metaData  Json?
  users     User[]    @relation("UserAvatar")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
  DEVELOPER
}

model QuizQuestion {
  id           Int      @id
  tenantId     String?
  category     String
  difficulty   String   @default("INTERMEDIATE") // BEGINNER | INTERMEDIATE | ADVANCED | EXPERT
  question     String   @db.Text
  codeSnippet  String?  @db.Text
  options      String[]
  correctIndex Int
  explanation  String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([category])
  @@index([difficulty])
}

model QuizProgress {
  id            String   @id @default(uuid())
  tenantId      String?
  userId        String?
  sessionId     String   @default("default-session")
  answers       Json     @default("{}")
  score         Int      @default(0)
  answeredCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([tenantId, sessionId])
  @@index([tenantId])
  @@index([userId])
}
