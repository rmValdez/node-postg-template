PORT=5002
NODE_ENV="development"

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/node_postg_db?schema=public"

# Browser origins allowed to call this API with credentials, comma-separated.
# Required in production — an empty value blocks all cross-origin browser
# requests. Not used in development (any origin is reflected there).
CORS_ORIGIN="https://app.example.com,https://admin.example.com"

# Docker Compose only (service interpolation in docker-compose.yml).
# In-container DATABASE_URL/REDIS_HOST/RABBITMQ_URL are derived from these.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=node_postg_db
POSTGRES_PORT=5432
REDIS_INSIGHT_PORT=5540
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Authentication (JWT)
ACCESS_TOKEN_SECRET="your-access-token-secret"
REFRESH_TOKEN_SECRET="your-refresh-token-secret"
ACCESS_TOKEN_EXPIRY="1d"

# Service-to-service auth (X-API-Key header) — one key per partner backend.
# Format: "clientName:key,otherClient:otherKey". Generate keys with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEYS="partner-a:replace-with-a-strong-random-key"

# Mailer (Ethereal for testing — https://ethereal.email)
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER="your-ethereal-email@ethereal.email"
SMTP_PASS="your-ethereal-password"

# Redis Cache & Rate Limiting
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_TTL_SECONDS=3600
REDIS_TLS=false               # Set to true for managed Redis (AWS ElastiCache, Upstash)

# RabbitMQ
RABBITMQ_URL="amqp://guest:guest@localhost:5672/"

# Worker Process
WORKER_HEALTH_PORT=8080       # Health probe port for Kubernetes/ECS — separate from API
METRICS_INTERVAL_MS=60000     # How often WorkerMetrics persists a snapshot to Redis

# Error Tracking (Sentry) — leave empty to disable entirely (no calls made anywhere)
SENTRY_DSN=""
